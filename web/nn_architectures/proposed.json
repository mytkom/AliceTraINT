  },
  "field_groups": [
    {
      "name": "data",
      "path": "data",
      "full_name": "Data",
      "fields": [
        {
          "name": "train_size",
          "full_name": "Train size",
          "type": "float64",
          "default_value": 0.64,
          "min": 0.0,
          "max": 1.0,
          "step": 0.01,
          "description": "Fraction of data used for training. Validation size is 1 - train_size - test_size."
        },
        {
          "name": "test_size",
          "full_name": "Test size",
          "type": "float64",
          "default_value": 0.2,
          "min": 0.0,
          "max": 1.0,
          "step": 0.01,
          "description": "Fraction of data used for testing."
        },
        {
          "name": "run_event_selection",
          "full_name": "Run event selection",
          "type": "bool",
          "default_value": true,
          "description": "Drop events that do not meet PIDMLProducer event selection criteria."
        },
        {
          "name": "use_event_data",
          "full_name": "Use event data",
          "type": "bool",
          "default_value": true,
          "description": "Include event-level columns in training features."
        },
        {
          "name": "use_n_sigma",
          "full_name": "Use n-sigma",
          "type": "bool",
          "default_value": false,
          "description": "Include n-sigma detector columns in training features."
        },
        {
          "name": "use_exp_sigma",
          "full_name": "Use expected sigma",
          "type": "bool",
          "default_value": true,
          "description": "Include expected TPC/TOF resolution columns in training features."
        },
        {
          "name": "outlier_filtering_method",
          "full_name": "Outlier filtering method",
          "type": "select",
          "default_value": null,
          "allow_null": true,
          "options": [
            {"value": null, "label": "None"},
            {"value": "iqr", "label": "IQR"},
            {"value": "ocsvm", "label": "One-Class SVM"},
            {"value": "isolation_forest", "label": "Isolation Forest"}
          ],
          "description": "Optional outlier filtering applied before training."
        }
      ],
      "groups": [
        {
          "name": "outlier_filtering_methods",
          "path": "data.outlier_filtering_methods",
          "full_name": "Outlier filtering parameters",
          "fields": [
            {
              "name": "columns",
              "full_name": "Filter columns",
              "type": "string_list",
              "default_value": ["fBeta", "fTOFSignal", "fTPCSignal", "fP"],
              "description": "Columns used by the selected outlier filter (comma-separated)."
            }
          ],
          "groups": [
            {
              "name": "iqr",
              "path": "data.outlier_filtering_methods.iqr",
              "full_name": "IQR",
              "show_when": {"field": "data.outlier_filtering_method", "equals": "iqr"},
              "fields": [
                {
                  "name": "multiplier",
                  "full_name": "IQR multiplier",
                  "type": "float64",
                  "default_value": 8.0,
                  "min": 0.0,
                  "max": 100.0,
                  "step": 0.1,
                  "description": "Multiplier for the interquartile range to define outliers."
                }
              ]
            },
            {
              "name": "ocsvm",
              "path": "data.outlier_filtering_methods.ocsvm",
              "full_name": "One-Class SVM",
              "show_when": {"field": "data.outlier_filtering_method", "equals": "ocsvm"},
              "fields": [
                {
                  "name": "kernel",
                  "full_name": "Kernel",
                  "type": "select",
                  "default_value": "rbf",
                  "options": [
                    {"value": "linear", "label": "linear"},
                    {"value": "poly", "label": "poly"},
                    {"value": "rbf", "label": "rbf"},
                    {"value": "sigmoid", "label": "sigmoid"},
                    {"value": "precomputed", "label": "precomputed"}
                  ],
                  "description": "Kernel type."
                },
                {
                  "name": "degree",
                  "full_name": "Degree",
                  "type": "int",
                  "default_value": 3,
                  "min": 1,
                  "max": 10,
                  "step": 1,
                  "description": "Degree of the polynomial kernel (if kernel=poly)."
                },
                {
                  "name": "gamma",
                  "full_name": "Gamma",
                  "type": "select",
                  "default_value": "scale",
                  "options": [
                    {"value": "scale", "label": "scale"},
                    {"value": "auto", "label": "auto"}
                  ],
                  "description": "Kernel coefficient for rbf/poly/sigmoid."
                },
                {
                  "name": "coef0",
                  "full_name": "Coef0",
                  "type": "float64",
                  "default_value": 0.0,
                  "min": -10.0,
                  "max": 10.0,
                  "step": 0.1,
                  "description": "Independent term in kernel function."
                },
                {
                  "name": "tol",
                  "full_name": "Tolerance",
                  "type": "float64",
                  "default_value": 0.001,
                  "min": 0.0,
                  "max": 1.0,
                  "step": 0.0001,
                  "description": "Stopping criterion tolerance."
                },
                {
                  "name": "nu",
                  "full_name": "Nu",
                  "type": "float64",
                  "default_value": 0.005,
                  "min": 0.0,
                  "max": 1.0,
                  "step": 0.001,
                  "description": "Upper bound on margin errors / lower bound on support vectors."
                },
                {
                  "name": "shrinking",
                  "full_name": "Shrinking",
                  "type": "bool",
                  "default_value": true,
                  "description": "Whether to use the shrinking heuristic."
                },
                {
                  "name": "cache_size",
                  "full_name": "Cache size (MB)",
                  "type": "float64",
                  "default_value": 400.0,
                  "min": 1.0,
                  "max": 8192.0,
                  "step": 1.0,
                  "description": "Kernel cache size in MB."
                }
              ]
            },
            {
              "name": "isolation_forest",
              "path": "data.outlier_filtering_methods.isolation_forest",
              "full_name": "Isolation Forest",
              "show_when": {"field": "data.outlier_filtering_method", "equals": "isolation_forest"},
              "fields": [
                {
                  "name": "n_estimators",
                  "full_name": "N estimators",
                  "type": "uint",
                  "default_value": 100,
                  "min": 1,
                  "max": 1000,
                  "step": 1,
                  "description": "Number of base estimators in the ensemble."
                },
                {
                  "name": "max_samples",
                  "full_name": "Max samples",
                  "type": "select",
                  "default_value": "auto",
                  "options": [
                    {"value": "auto", "label": "auto"}
                  ],
                  "description": "Samples drawn to train each base estimator."
                },
                {
                  "name": "contamination",
                  "full_name": "Contamination",
                  "type": "float64",
                  "default_value": 0.01,
                  "min": 0.0,
                  "max": 0.5,
                  "step": 0.001,
                  "description": "Expected proportion of outliers."
                },
                {
                  "name": "max_features",
                  "full_name": "Max features",
                  "type": "float64",
                  "default_value": 1.0,
                  "min": 0.0,
                  "max": 1.0,
                  "step": 0.01,
                  "description": "Fraction of features drawn to train each base estimator."
                },
                {
                  "name": "bootstrap",
                  "full_name": "Bootstrap",
                  "type": "bool",
                  "default_value": false,
                  "description": "Whether to use bootstrap sampling."
                },
                {
                  "name": "n_jobs",
                  "full_name": "N jobs",
                  "type": "int",
                  "default_value": -1,
                  "min": -1,
                  "max": 64,
                  "step": 1,
                  "description": "Parallel jobs (-1 = all processors)."
                }
              ]
            }
          ]
        }
      ]
    },
